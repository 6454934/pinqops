<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PinqOps</RootNamespace>
    <AssemblyName>PinqOps.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests reach internal helpers (e.g. the release checksum parser)
         without widening the library's public surface for them. -->
    <InternalsVisibleTo Include="PinqOps.Core.Tests" />
  </ItemGroup>

</Project>
